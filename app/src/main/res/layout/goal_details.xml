<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10221D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_back"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Goal Details"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- CATEGORY ICON -->
        <ImageView
            android:id="@+id/categoryIcon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:src="@drawable/ic_category_other" />

        <!-- GOAL NAME -->
        <TextView
            android:id="@+id/tvGoalTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Laptop"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginTop="16dp" />

        <!-- DATE -->
        <TextView
            android:id="@+id/tvGoalDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Target: Dec 31, 2026"
            android:textColor="#AAAAAA"
            android:layout_gravity="center" />

        <!-- SAVINGS BOX -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="16dp"
            android:background="@drawable/bg_simple_box"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Saved"
                android:textColor="#AAAAAA" />

            <TextView
                android:id="@+id/tvSavedAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱0 / ₱0"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProgressPercent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0%"
                    android:textColor="#00E5CC"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱0 remaining"
                    android:textColor="#AAAAAA" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progress="0"
                android:layout_marginTop="12dp"
                style="?android:attr/progressBarStyleHorizontal"
                android:progressDrawable="@drawable/progress_simple" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="#2E3D39" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You're on track!"
                android:textColor="#00E5CC"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weekly savings needed to reach your goal"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ACTION BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">

            <androidx.appcompat.widget.AppCompatButton
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_simple_button"
                android:text="View History"
                android:textColor="#10221D"
                android:textSize="14sp"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:layout_width="104dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_simple_button"
                android:text="Edit Goal"
                android:textColor="#10221D"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Delete"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_simple_button"
                app:backgroundTint="@null"
                android:textColor="#10221D" />
        </LinearLayout>

        <!-- ADD SAVINGS -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAddSavings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="+ Add Savings"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_simple_add"
            app:backgroundTint="@null"
            android:textColor="#000000" />

    </LinearLayout>
</ScrollView>
