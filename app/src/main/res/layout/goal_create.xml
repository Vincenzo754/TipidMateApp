<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10221D">

    <!-- Back Button -->
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_back"
        app:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/tv_create_goal_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create New Goal"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/btn_back"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_back" />

    <!-- Logo Background -->
    <FrameLayout
        android:id="@+id/logo_container"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_circle_dark"
        app:layout_constraintTop_toBottomOf="@id/tv_create_goal_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/logo_image"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@drawable/piggy" />
    </FrameLayout>

    <!-- Goal Title -->
    <TextView
        android:id="@+id/label_goal_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Goal Title"
        android:textColor="#FFFFFF"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/logo_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/et_goal_title"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="e.g New Laptop"
        android:background="@drawable/bg_input_rounded"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        app:layout_constraintTop_toBottomOf="@id/label_goal_title"
        app:layout_constraintStart_toStartOf="@id/label_goal_title"
        app:layout_constraintEnd_toEndOf="@id/label_goal_title" />

    <!-- Category -->
    <TextView
        android:id="@+id/label_category"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Category"
        android:textColor="#FFFFFF"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/et_goal_title"
        app:layout_constraintStart_toStartOf="@id/et_goal_title"
        app:layout_constraintEnd_toEndOf="@id/et_goal_title" />

    <Spinner
        android:id="@+id/sp_category"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_rounded"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toBottomOf="@id/label_category"
        app:layout_constraintStart_toStartOf="@id/label_category"
        app:layout_constraintEnd_toEndOf="@id/label_category" />

    <!-- Target Amount -->
    <TextView
        android:id="@+id/label_target_amount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Target Amount"
        android:textColor="#FFFFFF"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/sp_category"
        app:layout_constraintStart_toStartOf="@id/sp_category"
        app:layout_constraintEnd_toEndOf="@id/sp_category" />

    <EditText
        android:id="@+id/et_target_amount"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="₱ 0.00"
        android:inputType="numberDecimal"
        android:background="@drawable/bg_input_rounded"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        app:layout_constraintTop_toBottomOf="@id/label_target_amount"
        app:layout_constraintStart_toStartOf="@id/label_target_amount"
        app:layout_constraintEnd_toEndOf="@id/label_target_amount" />

    <!-- Completion Date -->
    <TextView
        android:id="@+id/label_completion_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Target Completion Date"
        android:textColor="#FFFFFF"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/et_target_amount"
        app:layout_constraintStart_toStartOf="@id/et_target_amount"
        app:layout_constraintEnd_toEndOf="@id/et_target_amount" />

    <EditText
        android:id="@+id/et_completion_date"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Select Date"
        android:focusable="false"
        android:background="@drawable/bg_input_rounded"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        app:layout_constraintTop_toBottomOf="@id/label_completion_date"
        app:layout_constraintStart_toStartOf="@id/label_completion_date"
        app:layout_constraintEnd_toEndOf="@id/label_completion_date" />

    <!-- Description -->
    <TextView
        android:id="@+id/label_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Description (Optional)"
        android:textColor="#FFFFFF"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/et_completion_date"
        app:layout_constraintStart_toStartOf="@id/et_completion_date"
        app:layout_constraintEnd_toEndOf="@id/et_completion_date" />

    <EditText
        android:id="@+id/et_description"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:hint="Brief description of your goal..."
        android:background="@drawable/bg_input_rounded"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        android:gravity="top"
        app:layout_constraintTop_toBottomOf="@id/label_description"
        app:layout_constraintStart_toStartOf="@id/label_description"
        app:layout_constraintEnd_toEndOf="@id/label_description" />

    <!-- Set Goal Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_set_goal"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="Set Goal"
        android:textStyle="bold"
        android:textColor="#000000"
        app:backgroundTint="#00E5CC"
        app:cornerRadius="14dp"
        app:rippleColor="#4000E5CC"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/et_description"
        app:layout_constraintStart_toStartOf="@id/et_description"
        app:layout_constraintEnd_toEndOf="@id/et_description"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
